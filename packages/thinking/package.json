{
  "name": "@mischief/thinking",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./src/node-storage.ts",
      "import": "./dist/node-storage.js",
      "default": "./dist/node-storage.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.1-main.73f8de8",
    "@earendil-works/pi-ai": "1.3.1-main.73f8de8",
    "@earendil-works/pi-durable": "1.3.1-main.73f8de8",
    "@mischief/core": "workspace:*",
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.1",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
