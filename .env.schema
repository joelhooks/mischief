# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Example non-secret setting. Replace with the project's real variables.
# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Deployment must select a named Alchemy profile.
# @required=forEnv(production)
# @sensitive=false
ALCHEMY_PROFILE=

# Native Effect tracing is opt-in. Cloudflare owns head sampling and export.
# @type=boolean
# @sensitive=false
TRACES_ENABLED=false

# Sample one percent of enabled invocations. The runtime accepts 0 through 1.
# @type=number
# @sensitive=false
TRACES_HEAD_SAMPLING_RATE=0.01

# Where the local CLI keeps run state. Defaults to ~/.mischief/runs.
# @sensitive=false
MISCHIEF_RUNS=

# The live durability proof only: hold every outbound send this many seconds
# so the host owner can kill the process mid-ask. Unset (off) in every other
# deploy; /.well-known/rat-king/version reports faultDelay while it is on.
# @type=number
# @sensitive=false
MISCHIEF_FAULT_HOLD_S=
