# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Example non-secret setting. Replace with the project's real variables.
# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Deployment must select a named Alchemy profile.
# @required=forEnv(production)
# @sensitive=false
ALCHEMY_PROFILE=

# Native Effect tracing is opt-in. Cloudflare owns head sampling and export.
# @type=boolean
# @sensitive=false
TRACES_ENABLED=false

# Sample one percent of enabled invocations. The runtime accepts 0 through 1.
# @type=number
# @sensitive=false
TRACES_HEAD_SAMPLING_RATE=0.01

# Where the local CLI keeps run state. Defaults to ~/.mischief/runs.
# @sensitive=false
MISCHIEF_RUNS=

# The Pi session's own canonical Rat King name, supplied by its launcher.
# Client tools refuse an unset, empty or off name; repo policy cannot choose it.
# @sensitive=false
RATKING_NAME=

# Existing Rat King identity, injected only into the public directory exporter.
# @sensitive=true
RATKING_IDENTITY_JSON=

# Which judge a Worker host wires. `jev` asks TypeSafe's Jev (needs
# MISCHIEF_JEV_KEY); `shadow` defers every judge step until a verdict arrives
# from shadow/judge over deliverReply; anything else leaves the judge unwired.
# @type=enum(jev, shadow, unwired)
# @sensitive=false
MISCHIEF_JUDGE=unwired

# Step kinds this host turns on, as a comma list. Each gated kind (today only
# `call`) is refused at validation unless listed here. Empty everywhere by
# default; turning a kind on for real runs needs the owner's approval.
# @sensitive=false
MISCHIEF_STEP_KINDS=

# How many think calls one run sends to the model at once. A parallel step
# starts every branch together; branches past the cap wait for a permit. Any
# positive whole number; empty means 20. A host refuses anything else at start.
# @sensitive=false
MISCHIEF_THINK_CONCURRENCY=

# Cross-run concurrent thinks per authenticated caller. Positive whole number;
# empty means 40. Excess work waits on its run alarm without consuming retries.
# @sensitive=false
MISCHIEF_CALLER_THINKS=

# Host-owned JSON map from caller DIDs to allowed Rat King recipient names.
# Derived from callers.json mischief.mayMail; absent entries reach only self.
# @sensitive=false
MISCHIEF_MAIL_REACH=

# Derived from callers.json mischief.peonCapabilities. No implicit grants.
# @sensitive=false
MISCHIEF_PEON_GRANTS=

# Exact comma-separated HTTPS hostnames allowed for watch GETs; empty disables HTTP checks.
# @sensitive=false
MISCHIEF_WATCH_HTTP_HOSTS=

# How many registered capability calls one run invokes at once, independently
# of think permits. Positive whole number; empty means 16.
# @sensitive=false
MISCHIEF_CALL_CONCURRENCY=

# Maximum unfinished model starts per run, step and visit. Positive
# whole number; empty means 3. Exhaustion fails the step and escalates.
# @sensitive=false
MISCHIEF_REDRIVE_ATTEMPTS=3

# Automatic overload resumes per run. Nonnegative whole number; 0 disables them.
# @sensitive=false
MISCHIEF_RESUME_ATTEMPTS=6

# Full-jitter exponential backoff window, in positive whole milliseconds.
# Provider hints are a floor, with jitter added after it.
# @sensitive=false
MISCHIEF_RESUME_BASE_MS=30000

# Maximum jitter window in positive whole milliseconds, not a hint ceiling.
# @sensitive=false
MISCHIEF_RESUME_CAP_MS=900000

# Additional Rat King names mailed once when a run exhausts automatic resumes.
# The run's escalateTo is always included. Comma-separated; empty by default.
# @sensitive=false
MISCHIEF_HOLD_ALARM_TO=

# The mischief/worker Rat King identity (JSON: did, signing, agreement). Lives
# only in the host's 0600 bindings file; never in Alchemy state or the plan.
# @sensitive=true
MISCHIEF_IDENTITY=

# The Rat King mailbox the Postbox seals for, sends to and reads from.
# @sensitive=false
MISCHIEF_MAILBOX_URL=

# The mailbox's service DID, the audience of the Postbox's service tokens.
# @sensitive=false
MISCHIEF_MAILBOX_DID=

# Deploy time: absolute path on the celld host of the 0600 JSON file holding
# MISCHIEF_IDENTITY. Unset deploys without Rat King mail (record-only outbox).
# @sensitive=false
MISCHIEF_BINDINGS_FILE=

# The Jev (TypeSafe) API key for a host whose judge is `jev`. On celld it comes
# only from the host's 0600 bindings file, never Alchemy state or the plan.
# @sensitive=true
MISCHIEF_JEV_KEY=

# Test only. `1` runs the skipped-by-default fan-out measurement in
# apps/worker/test/fanout-measure.test.ts on workerd; it writes its tables to
# apps/worker/dist/fanout-measure.md and fanout-wall.md.
# @type=enum(0, 1)
# @sensitive=false
MISCHIEF_MEASURE=0

# Test only. Comma-separated parallel widths for the fan-out measurement.
# Defaults to 25,50,100,200,400.
# @sensitive=false
MISCHIEF_MEASURE_WIDTHS=

# Test only. Comma-separated think output sizes in bytes for the fan-out
# measurement. Defaults to 1024,8192.
# @sensitive=false
MISCHIEF_MEASURE_OUTPUTS=

# Optional OpenAI Responses base URL, including /v1. Together with the key,
# this enables the Opus review route. Unset by default.
# @sensitive=false
MISCHIEF_OPUS_BRIDGE_URL=

# Shared bearer key. On celld it belongs in the private worker bindings file.
# @sensitive=true
MISCHIEF_OPUS_BRIDGE_KEY=

# Workspace execution stays off until the host enables the read-only bridge.
# @type=enum(off,on)
# @sensitive=false
MISCHIEF_WORKSPACE=off

# Comma-separated owner/repo allowlist for agent.workspace.repo.
# @sensitive=false
MISCHIEF_WORKSPACE_REPOS=

# Full Responses endpoint of the workspace bridge, including /v1/responses.
# @sensitive=false
MISCHIEF_WORKSPACE_BRIDGE_URL=

# Shared bearer used by the worker caller and verified by the workspace bridge; never passed into a sandbox.
# @sensitive=true
MISCHIEF_WORKSPACE_BRIDGE_KEY=

# Absolute built workspace bridge entry on the celld host, required when its URL is set.
# @sensitive=false
MISCHIEF_WORKSPACE_BRIDGE_ENTRY=

# Absolute built peon proxy entry on the celld host, required when the workspace bridge URL is set.
# @sensitive=false
MISCHIEF_PEON_PROXY_ENTRY=

# Absolute built bridge entry on the celld host. Required only when enabled.
# @sensitive=false
MISCHIEF_OPUS_BRIDGE_ENTRY=

# Bridge-only configuration, supplied by its private systemd EnvironmentFile.
# @sensitive=false
MISCHIEF_OPUS_PI_BIN=

# @sensitive=false
MISCHIEF_OPUS_CLAUDE_BIN=

# The approved claude-bridge extension's absolute src/index.ts path.
# @sensitive=false
MISCHIEF_OPUS_EXTENSION=

# Claude Code's cliproxy base URL (not the Responses /v1 base).
# @sensitive=false
MISCHIEF_OPUS_CLIPROXY_URL=

# Cliproxy client key, never the bridge's own bearer key.
# @sensitive=true
MISCHIEF_OPUS_CLIPROXY_KEY=

# Bind only loopback or a private host interface, never a public listener.
# @sensitive=false
MISCHIEF_OPUS_LISTEN_HOST=127.0.0.1

# @type=number
# @sensitive=false
MISCHIEF_OPUS_LISTEN_PORT=28010

# Workspace bridge-only JSON map: owner/repo to read-only HTTPS walgit URL.
# @sensitive=false
MISCHIEF_WORKSPACE_MIRRORS=

# Exact host[:port] allowed in every mirror URL. Credentials stay in host Git config.
# @sensitive=false
MISCHIEF_WORKSPACE_WALGIT_HOST=

# Absolute bridge-owned cache root; no symlinks. Contains exports, mirrors and metadata.
# @sensitive=false
MISCHIEF_WORKSPACE_EXPORTS_ROOT=

# Immutable workspace image reference, including @sha256:<64 lowercase hex>.
# @sensitive=false
MISCHIEF_WORKSPACE_IMAGE=

# Dedicated peon provider base URL, without /v1/responses or /v1/messages.
# @sensitive=false
MISCHIEF_PEON_CLIPROXY_URL=

# Host proxy only. Never mounted into a workspace or put in its environment.
# @sensitive=true
MISCHIEF_PEON_CLIPROXY_KEY=

# JSON model allowlist for the peon proxy. Both models must appear exactly once.
# @sensitive=false
MISCHIEF_PEON_MODELS=["gpt-6.1-sol","claude-opus-5-5"]

# Full peon boxes remain opt-in; shared with the worker bindings.
# @type=enum(off,on)
# @sensitive=false
MISCHIEF_PEON_BOXES=off

# Host box HTTP base URL, reachable only by the worker service.
# @sensitive=false
MISCHIEF_BOX_URL=

# Shared box-control bearer for the worker and box manager, never mounted in a peon.
# @sensitive=true
MISCHIEF_BOX_KEY=

# Spend-only bearer for the box manager and metering model proxies. Must differ from MISCHIEF_BOX_KEY.
# @sensitive=true
MISCHIEF_BOX_SPEND_KEY=

# Opt-in Rat King desk wakes on the celld host.
# @type=enum(off,on)
# @sensitive=false
MISCHIEF_DESK_WAKE=off

# Signed Rat King DID allowed to trigger and inspect desk wakes.
# @sensitive=false
MISCHIEF_DESK_WAKE_SENDER=did:web:operator.ratking-fleet.invalid

# Shared bearer for the loopback desk host and the Worker.
# @sensitive=true
MISCHIEF_DESK_WAKE_KEY=

# Absolute built entry for the desk host Node service.
# @sensitive=false
MISCHIEF_DESK_HOST_ENTRY=

# JSON argv prefix for the approved Muster restore command. Never put credentials in argv.
# @sensitive=false
MISCHIEF_DESK_RESTORE_CMD=

# Absolute, private local directory for desk wake idempotency receipts.
# @sensitive=false
MISCHIEF_DESK_WAKE_RECEIPTS=

# Minutes a woken desk stays idle before it exits. Required when the host is on.
# @sensitive=false
MISCHIEF_DESK_EXIT_WHEN_DRAINED=

# Full proxy model allowlist; host credentials never enter a box.
# @sensitive=false
MISCHIEF_PEON_FULL_MODELS=["gpt-6.1-sol","claude-opus-5-5"]

# Absolute built entry for the opt-in box manager.
# @sensitive=false
MISCHIEF_BOX_ENTRY=

# Absolute built entry for the opt-in full model proxy.
# @sensitive=false
MISCHIEF_PEON_FULL_PROXY_ENTRY=

# Immutable full image reference, including @sha256:<64 lowercase hex>.
# @sensitive=false
MISCHIEF_PEON_BOX_IMAGE=

# Per-image-key map of immutable image references. The full entry overrides the legacy variable.
# @sensitive=false
MISCHIEF_PEON_BOX_IMAGES=

# Optional host-owned directory of digest-pinned Burrow releases; never mounted itself.
# @sensitive=false
MISCHIEF_BOX_BROWSER_BUILDS=/opt/burrow-cells

# Max number of running browser boxes on this manager. Full boxes do not use this quota.
# @sensitive=false
MISCHIEF_BOX_BROWSER_MAX_LIVE=6

# Per-image-key JSON ceilings {dailyTokens, ratePerMin, defaultOutputTokens?}. Browser defaults to 2000000 and 20; full has no default.
# @sensitive=false
MISCHIEF_BOX_SPEND_LIMITS={"browser":{"dailyTokens":2000000,"ratePerMin":20}}

# Host Rat King sender for peon spend alarms addressed to peons/desk.
# @sensitive=false
MISCHIEF_BOX_SPEND_MAIL_AS=peons/spend-alarm

# Host Rat King CLI executable. Use an absolute path if not on the unit's PATH.
# @sensitive=false
MISCHIEF_BOX_SPEND_MAIL_BIN=ratking

# Test-only, local digest for the opt-in browser Docker smoke test.
# @sensitive=false
MISCHIEF_REAL_DOCKER_BROWSER_IMAGE=

# Required dedicated capped volume mountpoint when peon boxes are on; absolute, no default.
# @sensitive=false
MISCHIEF_BOX_MOUNT=

# Host-owned work and home mount root.
# @sensitive=false
MISCHIEF_BOX_ROOT=

# Host-owned hibernation snapshot root.
# @sensitive=false
MISCHIEF_BOX_SNAPSHOTS=

# Host-only metadata and idempotency receipts; never mounted in boxes.
# @sensitive=false
MISCHIEF_BOX_METADATA=

# Protected peon-sessions primary directory on the box host. Empty disables export and blocks destroy.
# @sensitive=false
MISCHIEF_BOX_ARCHIVE_PRIMARY=

# Read-only mount of the NAS replica's peon-sessions directory. The exporter never writes there.
# @sensitive=false
MISCHIEF_BOX_ARCHIVE_REPLICA=

# Short hostname allowed to write protected box archives. Empty disables archive operations.
# @sensitive=false
MISCHIEF_BOX_ARCHIVE_HOST=

# JSON owner/repo to absolute local walgit mirror directory map.
# @sensitive=false
MISCHIEF_BOX_MIRRORS=

# New scratch root for the opt-in real Docker lifecycle test; unset skips the test.
# @sensitive=false
MISCHIEF_REAL_DOCKER_SCRATCH=

# Approved local image for the opt-in real Docker lifecycle test.
# @sensitive=false
MISCHIEF_REAL_DOCKER_IMAGE=

# Unique mpt- container prefix for the opt-in real Docker lifecycle test.
# @sensitive=false
MISCHIEF_REAL_DOCKER_PREFIX=
