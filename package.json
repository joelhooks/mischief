{
  "name": "mischief",
  "version": "0.1.0",
  "private": true,
  "description": "Durable agent plans: dynamic XState machines stored as data, run in Durable Objects, talking over Rat King.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "acceptance:cold-clone": "bash scripts/acceptance-cold-clone.sh",
    "build": "turbo run build",
    "check": "pnpm run lockfile:check && varlock load && turbo run typecheck && ultracite check && oxfmt --check .",
    "cli": "turbo run build --filter=@mischief/cli && node apps/cli/dist/cli.js",
    "env:check": "varlock load",
    "fix": "ultracite fix && oxfmt .",
    "lint": "ultracite check && oxfmt --check .",
    "lockfile:check": "node scripts/lock-paths.ts && pnpm --config.optimistic-repeat-install=false install --frozen-lockfile --offline --lockfile-only --ignore-scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "infra:plan": "pnpm --filter @mischief/infra plan",
    "prepare": "effect-tsgo patch && if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck:fast": "turbo run typecheck:fast typecheck:fast-scripts",
    "typecheck:fast-scripts": "tsrs --noEmit -p tsconfig.json",
    "typecheck-scripts": "tsc --noEmit -p tsconfig.json",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh",
    "find-peers": "node scripts/find-peers.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@effect/tsgo": "0.69.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@oxlint/plugins": "1.93.0",
    "@types/node": "24.19.2",
    "effect": "4.1.4",
    "lefthook": "2.1.14",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "portless": "0.15.6",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "ultracite": "8.2.0",
    "varlock": "1.20.0",
    "vitest": "5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.3.0"
}
