{
  "name": "@mischief/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./build": "./celld-build.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "check": "pnpm run typecheck",
    "plan": "turbo run build --filter=@mischief/worker... --output-logs=errors-only && jiti plan.ts plan",
    "test": "vitest run",
    "destroy-plan": "jiti plan.ts destroy-plan",
    "deploy": "turbo run build --filter=@mischief/worker... --output-logs=errors-only && jiti plan.ts deploy",
    "destroy": "jiti plan.ts destroy",
    "probe": "jiti plan.ts probe",
    "render-units": "jiti plan.ts render-units"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@effect/platform-node": "4.1.4",
    "@mischief/core": "workspace:*",
    "@rat-king/alchemy-nest": "github:joelhooks/rat-king#4504f5443c820c7af94ecff629b147deff84c870&path:/packages/alchemy-nest",
    "@rat-king/mailbox-client": "github:joelhooks/rat-king#4504f5443c820c7af94ecff629b147deff84c870&path:/packages/mailbox-client/bundle",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@types/node": "24.19.2",
    "jiti": "2.7.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
