{
  "name": "@mischief/core",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.4",
    "@mischief/capability": "workspace:*",
    "@xstate/effect": "1.0.0-beta.0",
    "effect": "4.1.4",
    "xstate": "6.0.0-beta.1"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
