{
  "name": "@mischief/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "mischief": "./bin/mischief"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "cli": "pnpm run --silent build && node dist/cli.js",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "@mischief/capability": "workspace:*",
    "@mischief/core": "workspace:*",
    "@mischief/devtools": "workspace:*",
    "@mischief/thinking": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
