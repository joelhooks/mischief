{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "typecheck:fast": {
      "dependsOn": ["^typecheck:fast"],
      "outputs": []
    },
    "//#typecheck:fast-scripts": {
      "outputs": []
    },
    "@mischief/thinking#typecheck:fast": {
      "dependsOn": ["^typecheck:fast", "build"],
      "outputs": []
    },
    "@mischief/thinking#typecheck": {
      "dependsOn": ["^typecheck", "build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@mischief/worker#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "bundle/dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "passThroughEnv": ["VITEST_MAX_WORKERS"]
    },
    "@mischief/infra#test": {
      "dependsOn": ["build", "@mischief/worker#build"],
      "outputs": [],
      "passThroughEnv": ["VITEST_MAX_WORKERS"]
    },
    "//#lint": {
      "dependsOn": ["@mischief/capability#build", "@mischief/thinking#build"],
      "outputs": []
    },
    "//#typecheck-scripts": {
      "outputs": []
    },
    "//#lockfile:check": {
      "cache": false,
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "//#lockfile:check",
        "typecheck",
        "//#lint",
        "//#typecheck-scripts"
      ],
      "outputs": []
    }
  }
}
