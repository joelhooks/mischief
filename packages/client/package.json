{
  "name": "@mischief/client",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./pi": {
      "types": "./src/pi.ts",
      "import": "./dist/pi.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm run typecheck",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "@mischief/capability": "workspace:*",
    "@mischief/core": "workspace:*",
    "@rat-king/mailbox-client": "github:joelhooks/rat-king#9dbd61b5cb5d56a462c7a207ce8f14800089f49b&path:/packages/mailbox-client/bundle",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
