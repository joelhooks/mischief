exports[`box planning carries the mount condition into the manager unit and refuses an absent mount 1`] = `
{
  "name": "mischief-peon-boxes.service",
  "sections": [
    {
      "lines": [
        [
          "Description",
          "Mischief full peon box manager",
        ],
        [
          "ConditionPathIsMountPoint",
          "/srv/peon-volume",
        ],
      ],
      "name": "Unit",
    },
    {
      "lines": [
        [
          "EnvironmentFile",
          "/home/planner/.config/mischief/peon-boxes.env",
        ],
        [
          "ExecStart",
          "/usr/local/bin/node "/opt/mischief/box-main.js"",
        ],
        [
          "KillMode",
          "control-group",
        ],
        [
          "MemoryHigh",
          "3.5G",
        ],
        [
          "MemoryMax",
          "4G",
        ],
        [
          "MemorySwapMax",
          "0",
        ],
        [
          "NoNewPrivileges",
          "true",
        ],
        [
          "Restart",
          "on-failure",
        ],
        [
          "RestartSec",
          "10",
        ],
        [
          "SuccessExitStatus",
          "130",
        ],
        [
          "TimeoutStopSec",
          "10",
        ],
        [
          "Type",
          "simple",
        ],
        [
          "UMask",
          "0077",
        ],
      ],
      "name": "Service",
    },
    {
      "lines": [
        [
          "WantedBy",
          "default.target",
        ],
      ],
      "name": "Install",
    },
  ],
}
`;
