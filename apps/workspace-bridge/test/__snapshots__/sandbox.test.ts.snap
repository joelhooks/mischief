// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Servo argv: sha selects the read-only export; generated name enables teardown; thinking is a closed Pi enum; interactive carries bounded stdin; label enables crash sweep 1`] = `
{
  "args": [
    "run",
    "--rm",
    "--interactive",
    "--name",
    "mischief-peon-01234567-89ab-4cde-8fab-0123456789ab",
    "--label",
    "mischief.peon=1",
    "--network",
    "mischief-peons",
    "--cgroup-parent",
    "mischief-peons.slice",
    "--read-only",
    "--tmpfs",
    "/tmp:size=256m",
    "--cap-drop",
    "ALL",
    "--security-opt",
    "no-new-privileges",
    "--user",
    "65534:65534",
    "--memory",
    "2g",
    "--memory-swap",
    "2g",
    "--cpus",
    "1",
    "--pids-limit",
    "256",
    "-v",
    "/exports/0123456789abcdef0123456789abcdef01234567:/work:ro",
    "mischief/workspace@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "pi",
    "-p",
    "--no-session",
    "--tools",
    "read,grep,find,ls,bash",
    "--no-extensions",
    "--no-skills",
    "--no-prompt-templates",
    "--model",
    "peon/claude-opus-5-5",
    "--thinking",
    "medium",
    "--system-prompt",
    "You are a read-only code review peon. The input is a JSON envelope with instructions and text messages. Follow those instructions. Inspect /work with read, grep, find, ls and bash. Quote file paths and reference evidence. Do not attempt writes or network access.",
    "--mode",
    "json",
  ],
  "executable": "docker",
}
`;
