# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Example non-secret setting. Replace with the project's real variables.
# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Deployment must select a named Alchemy profile.
# @required=forEnv(production)
# @sensitive=false
ALCHEMY_PROFILE=

# Native Effect tracing is opt-in. Cloudflare owns head sampling and export.
# @type=boolean
# @sensitive=false
TRACES_ENABLED=false

# Sample one percent of enabled invocations. The runtime accepts 0 through 1.
# @type=number
# @sensitive=false
TRACES_HEAD_SAMPLING_RATE=0.01

# Where the local CLI keeps run state. Defaults to ~/.mischief/runs.
# @sensitive=false
MISCHIEF_RUNS=

# Which judge a Worker host wires. `jev` asks TypeSafe's Jev (needs
# MISCHIEF_JEV_KEY); `shadow` defers every judge step until a verdict arrives
# from shadow/judge over deliverReply; anything else leaves the judge unwired.
# @type=enum(jev, shadow, unwired)
# @sensitive=false
MISCHIEF_JUDGE=unwired

# Step kinds this host turns on, as a comma list. Each gated kind (today only
# `call`) is refused at validation unless listed here. Empty everywhere by
# default; turning a kind on for real runs needs the owner's approval.
# @sensitive=false
MISCHIEF_STEP_KINDS=

# The mischief/worker Rat King identity (JSON: did, signing, agreement). Lives
# only in the host's 0600 bindings file; never in Alchemy state or the plan.
# @sensitive=true
MISCHIEF_IDENTITY=

# The Rat King mailbox the Postbox seals for, sends to and reads from.
# @sensitive=false
MISCHIEF_MAILBOX_URL=

# The mailbox's service DID, the audience of the Postbox's service tokens.
# @sensitive=false
MISCHIEF_MAILBOX_DID=

# Deploy time: absolute path on the celld host of the 0600 JSON file holding
# MISCHIEF_IDENTITY. Unset deploys without Rat King mail (record-only outbox).
# @sensitive=false
MISCHIEF_BINDINGS_FILE=

# The Jev (TypeSafe) API key for a host whose judge is `jev`. On celld it comes
# only from the host's 0600 bindings file, never Alchemy state or the plan.
# @sensitive=true
MISCHIEF_JEV_KEY=

# Test only. `1` runs the skipped-by-default fan-out measurement in
# apps/worker/test/fanout-measure.test.ts on workerd; it writes its tables to
# apps/worker/dist/fanout-measure.md and fanout-wall.md.
# @type=enum(0, 1)
# @sensitive=false
MISCHIEF_MEASURE=0

# Test only. Comma-separated parallel widths for the fan-out measurement.
# Defaults to 25,50,100,200,400.
# @sensitive=false
MISCHIEF_MEASURE_WIDTHS=

# Test only. Comma-separated think output sizes in bytes for the fan-out
# measurement. Defaults to 1024,8192.
# @sensitive=false
MISCHIEF_MEASURE_OUTPUTS=
