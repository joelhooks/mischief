    "test": "vitest run",
    "start": "node dist/main.js",
    "start:proxy": "node dist/proxy-main.js"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "@mischief/capability": "workspace:*",
    "@mischief/model-bridge": "workspace:*",
